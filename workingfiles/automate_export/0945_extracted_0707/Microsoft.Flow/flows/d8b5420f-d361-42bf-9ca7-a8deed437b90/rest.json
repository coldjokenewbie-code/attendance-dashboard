{
 "今日前綴": {
  "runAfter": {},
  "type": "Compose",
  "inputs": "formatDateTime(addHours(utcNow(),8),'yyyyMMdd')"
 },
 "取得清單項目": {
  "runAfter": {
   "今日前綴": [
    "Succeeded"
   ]
  },
  "type": "OpenApiConnection",
  "inputs": {
   "parameters": {
    "dataset": "https://techartgroup.sharepoint.com/sites/PLANNER_CK",
    "table": "9bd1cdf3-4d38-49d3-ab8f-51c7448455bc",
    "$filter": "@concat('startswith(Title,''', formatDateTime(addHours(utcNow(),8),'yyyyMMdd'), '_'')')\n",
    "$top": 5000
   },
   "host": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
    "connectionName": "shared_sharepointonline",
    "operationId": "GetItems"
   },
   "authentication": "@parameters('$authentication')"
  }
 },
 "延遲列": {
  "runAfter": {
   "取得清單項目": [
    "Succeeded"
   ]
  },
  "type": "Query",
  "inputs": {
   "from": "@outputs('取得清單項目')?['body/value']",
   "where": "@not(endsWith(item()?['Title'],'_TaskOnSchedule'))"
  }
 },
 "列出表格中的列_名冊": {
