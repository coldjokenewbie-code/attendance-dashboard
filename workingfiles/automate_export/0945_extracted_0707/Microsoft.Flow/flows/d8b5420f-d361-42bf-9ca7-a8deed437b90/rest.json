    "file": "01YOOPXWNA7INQ4QDWMVEYTEMZ3AXUFDUL",
    "table": "{67870985-434E-4538-AC8D-3C6A5B409136}"
   },
   "host": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness",
